generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}


model RipUser {
  id                    Int      @id // rip.fun user ID
  username              String   @unique // rip.fun username
  smartWalletAddress    String?  // smart_wallet_address from API
  ownerWalletAddress    String?  // owner_wallet_address from API  
  avatar                String?  // avatar URL
  banner                String?  // banner URL
  type                  String?  // user type
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  addresses RipUserAddress[]
  
  @@map("rip_users")
}

model RipUserAddress {
  id              String   @id @default(cuid())
  address         String   // blockchain address
  ripUserId       Int      // foreign key to RipUser
  discoveredAt    DateTime @default(now()) // when this address was discovered
  blockNumber     BigInt?  // block number where this was discovered
  
  ripUser RipUser @relation(fields: [ripUserId], references: [id], onDelete: Cascade)
  
  @@unique([address, ripUserId])
  @@map("rip_user_addresses")
}

model SyncStatus {
  id            String   @id @default(cuid())
  syncType      String   @unique // "blockchain_users"
  lastBlockNumber BigInt? // last synced block number
  lastSyncAt    DateTime @default(now())
  lastManualSyncAt DateTime? // last manual sync triggered by user
  status        String   @default("pending") // pending, running, completed, error
  errorMessage  String?
  
  @@map("sync_status")
}

model SalesEvent {
  id              String   @id @default(cuid())
  transactionHash String   
  blockNumber     BigInt
  logIndex        Int
  buyerAddress    String   // from topic1 (indexed)
  sellerAddress   String   // from topic2 (indexed)  
  nftContract     String   // from topic3 (indexed)
  tokenId         String   // from event data
  price           String   // Wei as string
  currency        String   // currency contract address
  
  // Card metadata (enriched from tokenURI)
  cardName        String?  // "Plusle"
  cardImage       String?  // "cards/sv4/CARD-RIP1XP7EYGDGKE80_1752702477766.png"
  cardUniqueId    String?  // "CARD-RIP1XP7EYGDGKE80"  
  cardId          String?  // "sv3pt5-104" - Card ID from onchain metadata
  cardRarity      String?  // "Common"
  cardSet         String?  // "Paradox Rift"
  packetId        String?  // "4553"
  
  // Username mappings (from existing userSync data)
  buyerUsername   String?
  sellerUsername  String?
  
  timestamp       DateTime @default(now())

  // Composite unique constraint for bulk purchases (same transaction, different logIndex)
  @@unique([transactionHash, logIndex])
  
  // Indexes for efficient queries
  @@index([timestamp])
  @@index([buyerAddress])
  @@index([sellerAddress])
  @@index([cardSet])
  @@map("sales_events")
}