{
	"name": "rip-fun-data-extractor",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=20.19.0"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:redis": "docker-compose up -d redis && npm run dev",
		"build": "prisma generate && vite build",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"postinstall": "prisma generate",
		"redis:start": "docker-compose up -d redis",
		"redis:stop": "docker-compose down redis",
		"redis:logs": "docker-compose logs -f redis",
		"cache:warm": "tsx scripts/warm-cache.ts",
		"deploy:prepare": "npm run cache:warm",
		"test:enrichment": "tsx src/lib/scripts/testEnrichmentMigration.ts"
	},
	"dependencies": {
		"@prisma/client": "^5.22.0",
		"@sveltejs/adapter-node": "^5.3.1",
		"@types/ws": "^8.18.1",
		"alchemy-sdk": "^3.6.3",
		"autoprefixer": "^10.4.16",
		"bcrypt": "^5.1.1",
		"ioredis": "^5.7.0",
		"jsonwebtoken": "^9.0.2",
		"postcss": "^8.4.31",
		"tailwindcss": "^3.4.0",
		"viem": "^2.34.0",
		"ws": "^8.18.3"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/typography": "^0.5.10",
		"@types/bcrypt": "^5.0.2",
		"@types/jsonwebtoken": "^9.0.7",
		"@types/node": "^24.3.0",
		"prisma": "^5.22.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tsx": "^4.20.5",
		"typescript": "^5.0.0",
		"vite": "^7.0.4"
	}
}
